# Copy this file to .env.local and fill in the values.
# Never commit .env.local to GitHub.

# MongoDB connection string.
#  - Local MongoDB / `npm run db`:  mongodb://127.0.0.1:27017/moms-kitchen
#  - MongoDB Atlas:                 mongodb+srv://<user>:<password>@<cluster>/moms-kitchen
MONGODB_URI=mongodb://127.0.0.1:27017/moms-kitchen

# Secret used to sign login sessions. Generate one with:
#   npx auth secret     (or)     openssl rand -base64 32
AUTH_SECRET=change-me-to-a-long-random-string

# Fill the database with sample kitchens, food and demo accounts the first
# time the app connects to an empty database. Set to "false" to disable.
AUTO_SEED=true

# Optional services listed in the project report (not required to run):
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
