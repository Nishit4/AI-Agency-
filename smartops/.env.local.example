# =========================================
# SmartOps — Environment Variables Template
# Copy this file to .env.local and fill in real values.
# All services below have a free tier.
# =========================================

# --- Supabase (https://supabase.com — free tier) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# --- Anthropic Claude API (https://console.anthropic.com) ---
ANTHROPIC_API_KEY=sk-ant-your-key
CLAUDE_MODEL=claude-sonnet-4-6

# --- Resend Email (https://resend.com — free 3000/month) ---
RESEND_API_KEY=re_your_key
RESEND_FROM_EMAIL=SmartOps <noreply@yourdomain.com>

# --- Razorpay (https://razorpay.com — India payments) ---
RAZORPAY_KEY_ID=rzp_test_your_key
RAZORPAY_KEY_SECRET=your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# --- n8n (self-hosted on Railway free tier) ---
N8N_BASE_URL=https://your-n8n-instance.up.railway.app
N8N_API_KEY=your_n8n_api_key
N8N_WEBHOOK_SECRET=your_n8n_webhook_shared_secret

# --- Cal.com (https://cal.com — embed, free tier) ---
NEXT_PUBLIC_CALCOM_LINK=your-username/intro-call

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
CEO_EMAIL=you@yourdomain.com
