{
  "name": "@legacymodern/mcp-spec-bridge",
  "version": "1.0.0",
  "description": "MCP server that exposes Gemini-extracted legacy specifications and behavioral contracts to Claude Code",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "legacymodern-spec-bridge": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/index.js",
    "dev": "tsc -p tsconfig.json --watch",
    "test": "npm run build && node --test test/*.test.mjs",
    "inspect": "npx @modelcontextprotocol/inspector node dist/index.js"
  },
  "dependencies": {
    "@google/genai": "^2.28.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3"
  }
}
