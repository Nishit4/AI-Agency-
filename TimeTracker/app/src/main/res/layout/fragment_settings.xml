<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Material3.CardView.Filled"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="?attr/colorPrimaryContainer">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/profileInitial"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:background="@drawable/bg_circle"
                        android:backgroundTint="?attr/colorPrimary"
                        android:gravity="center"
                        android:importantForAccessibility="no"
                        android:textAppearance="?attr/textAppearanceHeadlineSmall"
                        android:textColor="?attr/colorOnPrimary"
                        tools:text="V" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/profileName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textAppearance="?attr/textAppearanceTitleLarge"
                            android:textColor="?attr/colorOnPrimaryContainer"
                            tools:text="Vansh Panchal" />

                        <TextView
                            android:id="@+id/profileUsername"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textAppearance="?attr/textAppearanceBodyMedium"
                            android:textColor="?attr/colorOnPrimaryContainer"
                            tools:text="\@vansh" />

                        <TextView
                            android:id="@+id/profileLevel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:textAppearance="?attr/textAppearanceLabelLarge"
                            android:textColor="?attr/colorOnPrimaryContainer"
                            tools:text="Level 3 · Achiever · 420 XP" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                style="@style/Widget.TimeTracker.SectionTitle"
                android:text="@string/settings_section_account" />

            <include
                android:id="@+id/rowEditName"
                layout="@layout/item_setting_row" />

            <include
                android:id="@+id/rowChangePassword"
                layout="@layout/item_setting_row" />

            <TextView
                style="@style/Widget.TimeTracker.SectionTitle"
                android:text="@string/settings_section_preferences" />

            <include
                android:id="@+id/rowTheme"
                layout="@layout/item_setting_row" />

            <include
                android:id="@+id/rowNotifications"
                layout="@layout/item_setting_row" />

            <include
                android:id="@+id/rowExactAlarms"
                layout="@layout/item_setting_row" />

            <TextView
                style="@style/Widget.TimeTracker.SectionTitle"
                android:text="@string/settings_section_data" />

            <include
                android:id="@+id/rowSampleData"
                layout="@layout/item_setting_row" />

            <include
                android:id="@+id/rowAbout"
                layout="@layout/item_setting_row" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/logoutButton"
                style="@style/Widget.Material3.Button.OutlinedButton.Icon"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="24dp"
                android:text="@string/action_logout"
                android:textColor="?attr/colorError"
                app:icon="@drawable/ic_logout"
                app:iconTint="?attr/colorError"
                app:strokeColor="?attr/colorError" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
